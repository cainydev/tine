package views

// Nav is the header state shared by every page.
type Nav struct {
	UserSlug string
	Email    string
	SignedIn bool
}

templ Layout(title string, nav Nav) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · tine</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="h-full bg-neutral-950 text-neutral-200 antialiased">
			<div class="mx-auto flex min-h-full max-w-4xl flex-col px-6">
				@header(nav)
				<main class="flex-1 py-10">
					{ children... }
				</main>
				@footer()
			</div>
		</body>
	</html>
}

templ header(nav Nav) {
	<header class="flex items-center justify-between border-b border-neutral-800 py-5">
		<a href="/" class="text-lg font-medium tracking-tight text-neutral-100">tine</a>
		if nav.SignedIn {
			<nav class="flex items-center gap-6 text-sm">
				<a href={ templ.SafeURL("/" + nav.UserSlug) } class="text-neutral-400 transition hover:text-neutral-100">
					instances
				</a>
				<a href="/integrations" class="text-neutral-400 transition hover:text-neutral-100">
					integrations
				</a>
				<a href="/settings" class="text-neutral-400 transition hover:text-neutral-100">
					settings
				</a>
				<form method="post" action="/logout">
					<button type="submit" class="text-neutral-500 transition hover:text-neutral-300">
						sign out
					</button>
				</form>
			</nav>
		} else {
			<a href="/login" class="text-sm text-neutral-400 transition hover:text-neutral-100">sign in</a>
		}
	</header>
}

templ footer() {
	<footer class="border-t border-neutral-800 py-6 text-xs text-neutral-600">
		one endpoint per connection
	</footer>
}

// Page is a titled section with optional description.
templ Page(heading, description string) {
	<div class="mb-8">
		<h1 class="text-2xl font-medium tracking-tight text-neutral-100">{ heading }</h1>
		if description != "" {
			<p class="mt-2 text-sm text-neutral-500">{ description }</p>
		}
	</div>
	{ children... }
}

// Alert reports an error to the user.
templ Alert(message string) {
	if message != "" {
		<div class="mb-6 rounded border border-red-900/60 bg-red-950/40 px-4 py-3 text-sm text-red-300">
			{ message }
		</div>
	}
}

// Empty is shown where a list has no entries.
templ Empty(message string) {
	<div class="rounded border border-dashed border-neutral-800 px-6 py-10 text-center text-sm text-neutral-500">
		{ message }
	</div>
}
