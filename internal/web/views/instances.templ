package views

import "fmt"

// Instance is one configured endpoint as shown in the interface.
type Instance struct {
	ID              string
	DisplayName     string
	IntegrationSlug string
	IntegrationName string
	Version         string
	Enabled         bool
	CredentialKind  string
	NeedsReauth     bool
	Endpoint        string
}

// Integration is one entry in the catalogue.
type Integration struct {
	Slug      string
	Name      string
	Version   string
	Params    []Param
	Instances int
}

// Param is one instance setting an integration accepts.
type Param struct {
	Key         string
	Description string
	Required    bool
	Default     string
	Enum        []string
	Value       string
}

// InstanceList is every instance a user owns.
templ InstanceList(nav Nav, instances []Instance) {
	@Layout("instances", nav) {
		@Page("instances", "each one is served at its own endpoint, with its own credential") {
			if len(instances) == 0 {
				@Empty("no instances yet. add one from the integrations page.")
			} else {
				<ul class="space-y-3">
					for _, in := range instances {
						@instanceCard(nav.UserSlug, in)
					}
				</ul>
			}
		}
	}
}

// IntegrationInstances is every instance of one integration.
templ IntegrationInstances(nav Nav, integration Integration, instances []Instance) {
	@Layout(integration.Slug, nav) {
		@Page(integration.Name, fmt.Sprintf("version %s", integration.Version)) {
			<div class="mb-6">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/%s/%s/new", nav.UserSlug, integration.Slug)) }
					class="inline-flex items-center rounded bg-neutral-100 px-3 py-1.5 text-sm font-medium text-neutral-900 transition hover:bg-white"
				>
					new instance
				</a>
			</div>
			if len(instances) == 0 {
				@Empty(fmt.Sprintf("no %s instances yet", integration.Slug))
			} else {
				<ul class="space-y-3">
					for _, in := range instances {
						@instanceCard(nav.UserSlug, in)
					}
				</ul>
			}
		}
	}
}

templ instanceCard(userSlug string, in Instance) {
	<li class="rounded border border-neutral-800 bg-neutral-900/40 p-4 transition hover:border-neutral-700">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/%s/%s/%s", userSlug, in.IntegrationSlug, in.ID)) }
					class="font-medium text-neutral-100 hover:underline"
				>
					{ in.DisplayName }
				</a>
				<p class="mt-1 truncate font-mono text-xs text-neutral-500">{ in.Endpoint }</p>
			</div>
			<div class="flex shrink-0 items-center gap-2">
				@credentialBadge(in)
				if !in.Enabled {
					<span class="rounded bg-neutral-800 px-2 py-0.5 text-xs text-neutral-400">disabled</span>
				}
			</div>
		</div>
	</li>
}

templ credentialBadge(in Instance) {
	if in.NeedsReauth {
		<span class="rounded bg-red-950 px-2 py-0.5 text-xs text-red-300">needs reauth</span>
	} else if in.CredentialKind == "" || in.CredentialKind == "none" {
		<span class="rounded bg-neutral-800 px-2 py-0.5 text-xs text-neutral-400">no credential</span>
	} else {
		<span class="rounded bg-emerald-950 px-2 py-0.5 text-xs text-emerald-300">{ in.CredentialKind }</span>
	}
}

// IntegrationList is the catalogue of integrations compiled into the binary.
templ IntegrationList(nav Nav, integrations []Integration) {
	@Layout("integrations", nav) {
		@Page("integrations", "compiled into this binary") {
			<ul class="space-y-3">
				for _, g := range integrations {
					<li class="rounded border border-neutral-800 bg-neutral-900/40 p-4">
						<div class="flex items-start justify-between gap-4">
							<div>
								<a
									href={ templ.SafeURL(fmt.Sprintf("/%s/%s", nav.UserSlug, g.Slug)) }
									class="font-medium text-neutral-100 hover:underline"
								>
									{ g.Name }
								</a>
								<p class="mt-1 font-mono text-xs text-neutral-500">{ g.Slug } · { g.Version }</p>
							</div>
							<div class="flex shrink-0 items-center gap-3">
								if g.Instances > 0 {
									<span class="text-xs text-neutral-500">
										{ fmt.Sprintf("%d configured", g.Instances) }
									</span>
								}
								<a
									href={ templ.SafeURL(fmt.Sprintf("/%s/%s/new", nav.UserSlug, g.Slug)) }
									class="rounded border border-neutral-700 px-3 py-1 text-sm text-neutral-300 transition hover:border-neutral-500 hover:text-neutral-100"
								>
									add
								</a>
							</div>
						</div>
					</li>
				}
			</ul>
		}
	}
}
